{
  "name": "skill-reminder",
  "version": "0.2.3",
  "description": "在 DSH 主 Agent 回合结束时提醒按需使用学习和 Docs Skill",
  "type": "module",
  "main": "./src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./package.json": "./package.json"
  },
  "files": ["src/index.mjs", "src/reminders.mjs", "src/workspace-config.mjs", "prompts", "skills", "cordis.patch.yml", "config.example.json"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "scripts": {
    "pack": "node scripts/pack.mjs",
    "pack:codex": "node scripts/pack-codex.mjs",
    "test": "node --test"
  },
  "engines": { "node": ">=22" },
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.1.0",
    "@deepseek-ai/dsh-agent": "0.2.2-rc.1",
    "@deepseek-ai/dsh-agent-loop": "0.2.2-rc.1",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session": "0.2.2-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.2-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.2-rc.1"
  }
}
